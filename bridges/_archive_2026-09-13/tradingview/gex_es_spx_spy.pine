avwapWidth = input.int(2, "AVWAP Line Width", minval=1, maxval=4, group=groupAVWAP)
showAvwapLabels = input.bool(true, "Labels", group=groupAVWAP, inline="avopt")
showAvwapExtend = input.bool(true, "Extend Lines Right", group=groupAVWAP, inline="avopt")

groupCol = "Colors & Style"
colorScheme = input.string("Wall Street Classic", "Color Theme", options=["Wall Street Classic", "Boreal", "Lady Trader"], group=groupCol)
colorZeroGamma = input.color(#9ca3af, "Zero Gamma", group=groupCol, inline="sys1")
colorMaxPain = input.color(#ef4444, "Max Pain", group=groupCol, inline="sys1")
colorEM = input.color(#3b82f6, "Expected Move", group=groupCol, inline="sys2")
colorVolBand = input.color(#9ca3af, "Vol Bands", group=groupCol, inline="sys2")
colorStructure = input.color(#9ca3af, "Structure", group=groupCol)
colorCharm = input.color(#f97316, "Charm Magnet", group=groupCol)
colorDeltaFlip = input.color(#f59e0b, "Delta Flip", group=groupCol)
lineLeftExt = input.int(50, "Line Left Extension", minval=1, group=groupCol)
lineStyleInput = input.string("Dotted", "Line Style", options=["Solid", "Dashed", "Dotted"], group=groupCol)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupCol)
labelSide = input.string("Left", "Label Side", options=["Left", "Right"], group=groupCol, tooltip="Where level labels render. Right places them clear of both candles and the GEX profile bars (recommended on busy charts).")
barColorStyle = input.string("Theme Colors", "Profile Bar Color", options=["Theme Colors", "Greyscale"], group=groupCol)

groupConfluence = "Confluence Zones"
showConfluence = input.bool(true, "Show Confluence Zones", group=groupConfluence)
confluenceMinSize = input.int(3, "Min cluster size for box", minval=2, maxval=5, group=groupConfluence, tooltip="Box drawn only when cluster has ≥N levels")
confluenceBandPoints = input.float(5.0, "Band Width (points)", minval=1.0, maxval=50.0, step=0.5, group=groupConfluence, tooltip="Total band in points. Half-band = this / 2 (e.g. 5 = ±2.5 pts).")
colorConfluence3 = input.color(color.new(#facc15, 75), "3-level", group=groupConfluence, inline="cc1")
colorConfluence4 = input.color(color.new(#fb923c, 70), "4-level", group=groupConfluence, inline="cc1")
colorConfluence5 = input.color(color.new(#ef4444, 65), "5+ (UBER)", group=groupConfluence, inline="cc1")

groupAlerts = "Alerts"
enableAlerts = input.bool(false, "Enable Level Cross Alerts", group=groupAlerts)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  CORE FUNCTIONS                                                              ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// Identity fallback when esSpxSpread is missing from the data string (= 0):
// shows ES strikes unchanged for SPX/SPY too. Better than applying a stale
// hardcoded default that would silently shift every level.
f_convertPrice(float esPrice) =>
    esSpxSpread <= 0 ? esPrice : tickerChoice == "SPX" ? esPrice - esSpxSpread : tickerChoice == "SPY" ? (esPrice - esSpxSpread) / 10.0 : esPrice

f_formatPrice(float esPrice) =>
    float cv = f_convertPrice(esPrice)
    tickerChoice == "SPY" ? str.tostring(cv, "#.##") : str.tostring(cv, "#")

f_lineStyle(string s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

color colorPos = colorScheme == "Boreal" ? #22d3ee : colorScheme == "Lady Trader" ? #2dd4bf : #22c55e
color colorNeg = colorScheme == "Boreal" ? #f472b6 : colorScheme == "Lady Trader" ? #c084fc : #ef4444

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  GEX STATE                                                                   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

var box[] gexBoxes = array.new_box()
var box[] confluenceBoxes = array.new_box()
var label[] confluenceLabels = array.new_label()
var line[] gexLines = array.new_line()
var label[] gexLabels = array.new_label()
var label timestampLabel = na
var string prevState = ""
var int lastBarIdx = -1

// BOS state
var line[] bosLines = array.new_line()
var label[] bosLabels = array.new_label()
var float[] bosLevels = array.new_float()
var bool[] bosBullish = array.new_bool()
var string[] bosTF = array.new_string()

// Wall flip tracking (5-min close based — see WALL FLIP section below)
// Walls parsed from data: ES-units strike, type CW/PW, count of consecutive
// 5m closes beyond the strike in the "currently-out" direction, and the
// current flipped flag.
var float[]  wallStrikes  = array.new_float()
var string[] wallTypes    = array.new_string()
var int[]    wallCounters = array.new_int()
var bool[]   wallFlipped  = array.new_bool()
var string   wallParseKey = ""

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  BREAKOUT STRUCTURE — M/W/D/H4/H1                                            ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// ta.change at top-level (Pine requirement)
bool mChanged  = ta.change(time("M")) != 0
bool wChanged  = ta.change(time("W")) != 0
bool dChanged  = ta.change(time("D")) != 0
bool h4Changed = ta.change(time("240")) != 0
bool h1Changed = ta.change(time("60")) != 0

// request.security — top-level calls
[mPrevH, mPrevL, mCurrC, mCurrH, mCurrL]       = request.security(syminfo.tickerid, "M",   [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[wPrevH, wPrevL, wCurrC, wCurrH, wCurrL]       = request.security(syminfo.tickerid, "W",   [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[dPrevH, dPrevL, dCurrC, dCurrH, dCurrL]       = request.security(syminfo.tickerid, "D",   [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[h4PrevH, h4PrevL, h4CurrC, h4CurrH, h4CurrL] = request.security(syminfo.tickerid, "240", [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[h1PrevH, h1PrevL, h1CurrC, h1CurrH, h1CurrL] = request.security(syminfo.tickerid, "60",  [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)

// ── 5-minute close stream — used by the Wall Flip tracker below ──
// We pull the 5-min close regardless of the chart's display timeframe, so the
// flip rule (2 consecutive 5m closes beyond the wall) behaves identically on
// a 1m, 5m, 1h, or daily chart.
[close5m, time5m] = request.security(syminfo.tickerid, "5", [close, time], lookahead=barmerge.lookahead_off)
bool new5mBar = ta.change(time5m) != 0


f_checkBOS(float prevH, float prevL, float currC, float currH, float currL, bool changed, bool enabled) =>
    float bullLevel = na
    float bearLevel = na
    if enabled and changed and not na(prevH)
        if currC > prevH
            float bodyAbove = currC - prevH
            float upperShadow = currH - currC
            if bodyAbove > upperShadow and bodyAbove > 0
                bullLevel := prevH
        if currC < prevL
            float bodyBelow = prevL - currC
            float lowerShadow = currC - currL
            if bodyBelow > lowerShadow and bodyBelow > 0
                bearLevel := prevL
    [bullLevel, bearLevel]

[mBull, mBear]   = f_checkBOS(mPrevH, mPrevL, mCurrC, mCurrH, mCurrL, mChanged, showBOS_M)
[wBull, wBear]   = f_checkBOS(wPrevH, wPrevL, wCurrC, wCurrH, wCurrL, wChanged, showBOS_W)
[dBull, dBear]   = f_checkBOS(dPrevH, dPrevL, dCurrC, dCurrH, dCurrL, dChanged, showBOS_D)
[h4Bull, h4Bear] = f_checkBOS(h4PrevH, h4PrevL, h4CurrC, h4CurrH, h4CurrL, h4Changed, showBOS_H4)
[h1Bull, h1Bear] = f_checkBOS(h1PrevH, h1PrevL, h1CurrC, h1CurrH, h1CurrL, h1Changed, showBOS_H1)

// Add BOS
f_addBOS(float level, bool isBull, string tf) =>
    if not na(level)
        float cv = f_convertPrice(level)
        color clr = isBull ? colorBOS_Bull : colorBOS_Bear
        int sty = tf == "M" or tf == "W" or tf == "D" ? 0 : 1
        int w = tf == "M" ? bosLineWidth + 2 : tf == "W" ? bosLineWidth + 1 : tf == "D" ? bosLineWidth : math.max(bosLineWidth - 1, 1)
        line newL = line.new(bar_index, cv, bar_index + 1, cv, color=clr, style=sty == 0 ? line.style_solid : line.style_dashed, width=w, extend=extend.right)
        array.push(bosLines, newL)
        string dir = isBull ? "+" : "-"
        label newLbl = label.new(bar_index, cv, tf + dir, color=color.new(clr, 50), textcolor=color.white, style=isBull ? label.style_label_up : label.style_label_down, size=size.tiny)
        array.push(bosLabels, newLbl)
        array.push(bosLevels, cv)
        array.push(bosBullish, isBull)
        array.push(bosTF, tf)

f_addBOS(mBull, true, "M")
f_addBOS(mBear, false, "M")
f_addBOS(wBull, true, "W")
f_addBOS(wBear, false, "W")
f_addBOS(dBull, true, "D")
f_addBOS(dBear, false, "D")
f_addBOS(h4Bull, true, "H4")
f_addBOS(h4Bear, false, "H4")
f_addBOS(h1Bull, true, "H1")
f_addBOS(h1Bear, false, "H1")

// Invalidate broken BOS
if array.size(bosLines) > 0
    int i = array.size(bosLines) - 1
    while i >= 0
        float lvl = array.get(bosLevels, i)
        bool isBull = array.get(bosBullish, i)
        bool broken = isBull ? close < lvl : close > lvl
        if broken
            line.delete(array.get(bosLines, i))
            label.delete(array.get(bosLabels, i))
            array.remove(bosLines, i)
            array.remove(bosLabels, i)
            array.remove(bosLevels, i)
            array.remove(bosBullish, i)
            array.remove(bosTF, i)
        i -= 1

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  WALL FLIP TRACKING — 5m close based                                         ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
//
// Rule (per wall, single state per side):
//   CW non-flipped  →  2 consecutive 5m closes ABOVE strike  →  flipped
//   CW flipped      →  2 consecutive 5m closes BELOW strike  →  restored
//   PW non-flipped  →  2 consecutive 5m closes BELOW strike  →  flipped
//   PW flipped      →  2 consecutive 5m closes ABOVE strike  →  restored
//
// A flipped wall keeps its original nature color (CW pink / PW cyan) but is
// rendered with width-1 + a "↺" suffix on its label. Tooltip carries the
// "Flipped X→Y" explanation. Same wall, same identity — only its current role
// switched relative to spot.

// Parse walls from gexDataActive when the data changes. The arrays mirror the
// order in which CW/PW strikes appear, so the index used by tracking stays
// stable across bars.
f_parseWalls(string dataStr) =>
    array.clear(wallStrikes)
    array.clear(wallTypes)
    array.clear(wallCounters)
    array.clear(wallFlipped)
    string rest = dataStr
    if str.startswith(rest, "S:")
        int sEnd = str.pos(rest, "|")
        if sEnd > 2
            rest := str.substring(rest, sEnd + 1)
    string lvlSection = rest
    if str.contains(rest, "|P:")
        int pp = str.pos(rest, "|P:")
        lvlSection := str.substring(rest, 0, pp)
    if str.startswith(lvlSection, "L:")
        lvlSection := str.substring(lvlSection, 2)
    if lvlSection != ""
        string[] pairs = str.split(lvlSection, ";")
        for pair in pairs
            string[] p = str.split(pair, ",")
            if array.size(p) >= 2
                float s = str.tonumber(array.get(p, 0))
                string t = array.get(p, 1)
                if not na(s) and (t == "CW" or t == "PW")
                    array.push(wallStrikes, s)
                    array.push(wallTypes, t)
                    array.push(wallCounters, 0)
                    array.push(wallFlipped, false)

// Lookup helper — returns the current flipped state for a given ES-units strike.
// Falls back to false (not flipped) when the wall isn't tracked.
f_getWallFlipped(float strike) =>
    bool found = false
    int n = array.size(wallStrikes)
    int i = 0
    while i < n and not found
        if array.get(wallStrikes, i) == strike
            found := array.get(wallFlipped, i)
            i := n
        else
            i += 1
    found

// Re-parse walls when the data string changes (= user pastes a live override
// or weekly seed updates). Cheap to call; only the wallStrikes arrays touched.
if wallParseKey != gexDataActive
    wallParseKey := gexDataActive
    f_parseWalls(gexDataActive)

// On every closed 5m bar, evaluate each wall against close5m and bump the
// counter when the close is on the "currently-out" side. Two consecutive
// out-side closes flip (or restore) the wall.
// Note: strikes are in ES units. close5m is in chart-display units, so for
// SPX/SPY we lift it back into ES space before the comparison.
if new5mBar and array.size(wallStrikes) > 0
    float close5mES = close5m
    if esSpxSpread > 0 and tickerChoice == "SPX"
        close5mES := close5m + esSpxSpread
    else if esSpxSpread > 0 and tickerChoice == "SPY"
        close5mES := close5m * 10.0 + esSpxSpread
    int n = array.size(wallStrikes)
    for i = 0 to n - 1
        float strike = array.get(wallStrikes, i)
        string wType = array.get(wallTypes, i)
        bool   isF   = array.get(wallFlipped, i)
        int    cnt   = array.get(wallCounters, i)
        bool beyond = false
        if wType == "CW"
            // Not flipped: CW sits above price → "beyond" = close above strike.
            // Flipped     : CW sits below price → "beyond" = close below strike.
            beyond := isF ? close5mES < strike : close5mES > strike
        else if wType == "PW"
            // Not flipped: PW sits below price → "beyond" = close below strike.
            // Flipped     : PW sits above price → "beyond" = close above strike.
            beyond := isF ? close5mES > strike : close5mES < strike
        if beyond
            cnt += 1
            if cnt >= 2
                isF := not isF
                cnt := 0
        else
            cnt := 0
        array.set(wallCounters, i, cnt)
        array.set(wallFlipped, i, isF)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  SESSION BOXES                                                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

int etHour = hour(time, "America/New_York")
int etMin  = minute(time, "America/New_York")
int etMins = etHour * 60 + etMin

// Session detection (wraps midnight for Asia)
bool inAsia = etMins >= 1080 or etMins < 180    // 18:00-03:00
bool inEU   = etMins >= 180 and etMins < 480    // 03:00-08:00
bool inPre  = etMins >= 480 and etMins < 570    // 08:00-09:30
bool inUS   = etMins >= 570 and etMins < 960    // 09:30-16:00

// Session box tracking with proper lifecycle
var box curAsiaBox = na, var float _asiaHi = na, var float _asiaLo = na, var bool _asiaActive = false
var box curEUBox = na,   var float _euHi = na,   var float _euLo = na,   var bool _euActive = false
var box curPreBox = na,  var float _preHi = na,  var float _preLo = na,  var bool _preActive = false
var box curUSBox = na,   var float _usHi = na,   var float _usLo = na,   var bool _usActive = false

// Limit session boxes to current day unless showHistoricalSessions is on (30h = 1 futures day + buffer)
bool recentSessionOnly = showHistoricalSessions or (time >= timenow - 30 * 3600000)

// Asia
if showSessions and showAsia and recentSessionOnly
    if inAsia
        if not _asiaActive
            _asiaActive := true
            _asiaHi := high
            _asiaLo := low
            curAsiaBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorAsia, 70), border_width=1, bgcolor=colorAsia)
        else
            _asiaHi := math.max(_asiaHi, high)
            _asiaLo := math.min(_asiaLo, low)
            if not na(curAsiaBox)
                box.set_right(curAsiaBox, bar_index)
                box.set_top(curAsiaBox, _asiaHi)
                box.set_bottom(curAsiaBox, _asiaLo)
    else
        _asiaActive := false

// Europe
if showSessions and showEU and recentSessionOnly
    if inEU
        if not _euActive
            _euActive := true
            _euHi := high
            _euLo := low
            curEUBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorEU, 70), border_width=1, bgcolor=colorEU)
        else
            _euHi := math.max(_euHi, high)
            _euLo := math.min(_euLo, low)
            if not na(curEUBox)
                box.set_right(curEUBox, bar_index)
                box.set_top(curEUBox, _euHi)
                box.set_bottom(curEUBox, _euLo)
    else
        _euActive := false

// Pre-Market
if showSessions and showPre and recentSessionOnly
    if inPre
        if not _preActive
            _preActive := true
            _preHi := high
            _preLo := low
            curPreBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorPre, 70), border_width=1, bgcolor=colorPre)
        else
            _preHi := math.max(_preHi, high)
            _preLo := math.min(_preLo, low)
            if not na(curPreBox)
                box.set_right(curPreBox, bar_index)
                box.set_top(curPreBox, _preHi)
                box.set_bottom(curPreBox, _preLo)
    else
        _preActive := false

// US RTH
if showSessions and showUS and recentSessionOnly
    if inUS
        if not _usActive
            _usActive := true
            _usHi := high
            _usLo := low
            curUSBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorUS, 70), border_width=1, bgcolor=colorUS)
        else
            _usHi := math.max(_usHi, high)
            _usLo := math.min(_usLo, low)
            if not na(curUSBox)
                box.set_right(curUSBox, bar_index)
                box.set_top(curUSBox, _usHi)
                box.set_bottom(curUSBox, _usLo)
    else
        _usActive := false

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  SESSION AVWAP (Anchored VWAP per session)                                    ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// AVWAP — uses same session flags as boxes (reliable, no timenow dependency)
// Each AVWAP resets at its session start and accumulates through US close (16:00).
// All AVWAPs reset at new futures day (Asia start = 18:00 ET).

float src = hlc3
float vol = nz(volume, 1)  // fallback: zero-volume bars get weight 1

// Session start = first bar IN session after being OUT
bool asiaStart = inAsia and not inAsia[1]
bool euStart   = inEU   and not inEU[1]
bool usStart   = inUS   and not inUS[1]

// Track current futures day — reset flag at Asia start
var bool inCurrentDay = false
if asiaStart
    inCurrentDay := true

// Between 16:00-18:00 ET = gap, no futures day
bool inGap = etMins >= 960 and etMins < 1080
if inGap
    inCurrentDay := false

// Asia AVWAP — resets at Asia start, accumulates through US close
var float aSumPV = 0.0
var float aSumV  = 0.0
var bool asiaActive = false
if asiaStart
    aSumPV := src * vol
    aSumV  := vol
    asiaActive := true
else if asiaActive and inCurrentDay
    aSumPV += src * vol
    aSumV  += vol
float avwapAsia = aSumV > 0 ? aSumPV / aSumV : na

// EU AVWAP — resets at EU start, accumulates through US close
var float eSumPV = 0.0
var float eSumV  = 0.0
var bool euActive = false
if asiaStart
    euActive := false  // new day: EU hasn't started yet
if euStart
    eSumPV := src * vol
    eSumV  := vol
    euActive := true
else if euActive and inCurrentDay
    eSumPV += src * vol
    eSumV  += vol
float avwapEU = eSumV > 0 ? eSumPV / eSumV : na

// US AVWAP — resets at US start, accumulates through US close only
var float uSumPV = 0.0
var float uSumV  = 0.0
var bool usActive = false
if asiaStart
    usActive := false  // new day: US hasn't started yet
if usStart
    uSumPV := src * vol
    uSumV  := vol
    usActive := true
else if usActive and inUS
    uSumPV += src * vol
    uSumV  += vol
float avwapUS = uSumV > 0 ? uSumPV / uSumV : na

// US Previous Day AVWAP — promoted at futures day reset, accumulates on all bars
var float pdSumPV = 0.0
var float pdSumV  = 0.0
if asiaStart and uSumV > 0
    // Promote current US → PD before reset
    pdSumPV := uSumPV
    pdSumV  := uSumV
else if pdSumV > 0 and inCurrentDay
    pdSumPV += src * vol
    pdSumV  += vol
float avwapPD = pdSumV > 0 ? pdSumPV / pdSumV : na

// Show AVWAP only when active. When showHistoricalAVWAP is off, limit to last 30 hours (1 futures day + buffer).
bool recentOnly = showHistoricalAVWAP or (time >= timenow - 30 * 3600000)
float pAsia = showAVWAP and showAvwapAsia and asiaActive and inCurrentDay and recentOnly ? avwapAsia : na
float pEU   = showAVWAP and showAvwapEU   and euActive   and inCurrentDay and recentOnly ? avwapEU   : na
float pUS   = showAVWAP and showAvwapUS   and usActive   and inUS         and recentOnly ? avwapUS   : na
float pPD   = showAVWAP and showAvwapPD   and pdSumV > 0 and inCurrentDay and recentOnly ? avwapPD   : na

plot(pAsia, "AVWAP Asia",    color=colorAvwapAsia, linewidth=avwapWidth, style=plot.style_linebr)
plot(pEU,   "AVWAP EU",      color=colorAvwapEU,   linewidth=avwapWidth, style=plot.style_linebr)
plot(pUS,   "AVWAP US",      color=colorAvwapUS,   linewidth=avwapWidth, style=plot.style_linebr)
plot(pPD,   "AVWAP US Prev", color=colorAvwapPD,   linewidth=avwapWidth, style=plot.style_linebr)

// ── AVWAP Extension Lines (dotted, extend right from last value) ──
var line avwapLineAsia = na
var line avwapLineEU   = na
var line avwapLineUS   = na
var line avwapLinePD   = na

if showAVWAP and showAvwapExtend and barstate.islast
    if showAvwapAsia and not na(pAsia)
        if na(avwapLineAsia)
            avwapLineAsia := line.new(bar_index, pAsia, bar_index + 1, pAsia, color=colorAvwapAsia, width=avwapWidth, style=line.style_dotted, extend=extend.right)
        else
            line.set_xy1(avwapLineAsia, bar_index, pAsia)
            line.set_xy2(avwapLineAsia, bar_index + 1, pAsia)

    if showAvwapEU and not na(pEU)
        if na(avwapLineEU)
            avwapLineEU := line.new(bar_index, pEU, bar_index + 1, pEU, color=colorAvwapEU, width=avwapWidth, style=line.style_dotted, extend=extend.right)
        else
            line.set_xy1(avwapLineEU, bar_index, pEU)
            line.set_xy2(avwapLineEU, bar_index + 1, pEU)

    if showAvwapUS and not na(pUS)
        if na(avwapLineUS)
            avwapLineUS := line.new(bar_index, pUS, bar_index + 1, pUS, color=colorAvwapUS, width=avwapWidth, style=line.style_dotted, extend=extend.right)
        else
            line.set_xy1(avwapLineUS, bar_index, pUS)
            line.set_xy2(avwapLineUS, bar_index + 1, pUS)

    if showAvwapPD and not na(pPD)
        if na(avwapLinePD)
            avwapLinePD := line.new(bar_index, pPD, bar_index + 1, pPD, color=colorAvwapPD, width=avwapWidth, style=line.style_dashed, extend=extend.right)
        else
            line.set_xy1(avwapLinePD, bar_index, pPD)
            line.set_xy2(avwapLinePD, bar_index + 1, pPD)

// ── AVWAP Labels (on last bar, offset right) ──
var label avwapLblAsia = na
var label avwapLblEU   = na
var label avwapLblUS   = na
var label avwapLblPD   = na

if showAVWAP and showAvwapLabels and barstate.islast
    if showAvwapAsia and not na(pAsia)
        if na(avwapLblAsia)
            avwapLblAsia := label.new(bar_index + 3, pAsia, "ASIA " + str.tostring(pAsia, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapAsia)
        else
            label.set_xy(avwapLblAsia, bar_index + 3, pAsia)
            label.set_text(avwapLblAsia, "ASIA " + str.tostring(pAsia, format.mintick))

    if showAvwapEU and not na(pEU)
        if na(avwapLblEU)
            avwapLblEU := label.new(bar_index + 3, pEU, "EU " + str.tostring(pEU, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapEU)
        else
            label.set_xy(avwapLblEU, bar_index + 3, pEU)
            label.set_text(avwapLblEU, "EU " + str.tostring(pEU, format.mintick))

    if showAvwapUS and not na(pUS)
        if na(avwapLblUS)
            avwapLblUS := label.new(bar_index + 3, pUS, "US " + str.tostring(pUS, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapUS)
        else
            label.set_xy(avwapLblUS, bar_index + 3, pUS)
            label.set_text(avwapLblUS, "US " + str.tostring(pUS, format.mintick))

    if showAvwapPD and not na(pPD)
        if na(avwapLblPD)
            avwapLblPD := label.new(bar_index + 3, pPD, "US PD " + str.tostring(pPD, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapPD)
        else
            label.set_xy(avwapLblPD, bar_index + 3, pPD)
            label.set_text(avwapLblPD, "US PD " + str.tostring(pPD, format.mintick))

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  GEX LEVELS + PROFILE (last bar only — same logic as GEX Dashboard v6.8)     ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

string stateKey = gexDataActive + str.tostring(profileWidth) + str.tostring(barThickness) + str.tostring(profileOffset) + colorScheme + barColorStyle + lineStyleInput + str.tostring(lineWidth) + str.tostring(lineLeftExt) + tickerChoice
bool needsRedraw = barstate.islast and (stateKey != prevState or bar_index != lastBarIdx)

if needsRedraw
    // Clear previous
    for b in gexBoxes
        box.delete(b)
    array.clear(gexBoxes)
    for l in gexLines
        line.delete(l)
    array.clear(gexLines)
    for lbl in gexLabels
        label.delete(lbl)
    array.clear(gexLabels)
    if not na(timestampLabel)
        label.delete(timestampLabel)

    lastBarIdx := bar_index
    timestampLabel := label.new(bar_index + profileOffset, high + syminfo.mintick * 50, "TLADe " + tickerChoice, color=color.new(color.gray, 100), style=label.style_label_center, textcolor=color.new(color.gray, 40), size=size.tiny)

    // Parse S:|L:|P:
    string levelsData = ""
    string profileData = ""
    string rawInput = gexDataActive

    if str.startswith(rawInput, "S:")
        int sEnd = str.pos(rawInput, "|")
        if sEnd > 2
            float parsedSpread = str.tonumber(str.substring(rawInput, 2, sEnd))
            if not na(parsedSpread) and parsedSpread > 0
                esSpxSpread := parsedSpread
            rawInput := str.substring(rawInput, sEnd + 1)

    if str.contains(rawInput, "|P:")
        int pipePos = str.pos(rawInput, "|P:")
        string beforePipe = str.substring(rawInput, 0, pipePos)
        profileData := str.substring(rawInput, pipePos + 3)
        if str.startswith(beforePipe, "L:")
            levelsData := str.substring(beforePipe, 2)
    else
        profileData := rawInput

    // ── Draw Levels (identical to GEX Dashboard v6.8) ──
    if levelsData != ""
        string[] levelPairs = str.split(levelsData, ";")
        int gexAboveDrawn = 0
        int gexBelowDrawn = 0
        int halfMax = math.ceil(maxVisibleLevels / 2)

        // Find closest GEX to spot (protected)
        float closestAbove = na, float closestAboveDist = 999999.0
        float closestBelow = na, float closestBelowDist = 999999.0
        for lvlPair in levelPairs
            string[] p = str.split(lvlPair, ",")
            if array.size(p) >= 3
                float s = str.tonumber(array.get(p, 0))
                string t = array.get(p, 1)
                if not na(s) and (t == "CW" or t == "PW")
                    float cv = f_convertPrice(s)
                    float dist = math.abs(cv - close)
                    if cv > close and dist < closestAboveDist
                        closestAboveDist := dist
                        closestAbove := cv
                    else if cv <= close and dist < closestBelowDist
                        closestBelowDist := dist
                        closestBelow := cv

        for lvlPair in levelPairs
            string[] p = str.split(lvlPair, ",")
            if array.size(p) >= 3
                float lvlStrike = str.tonumber(array.get(p, 0))
                string lvlType = array.get(p, 1)
                string lvlLabel = array.get(p, 2)
                string lvlTooltip = array.size(p) >= 4 ? str.replace_all(array.get(p, 3), "~", "\n") : ""
                float lvlMag = array.size(p) >= 5 ? str.tonumber(array.get(p, 4)) : 0.0

                if not na(lvlStrike)
                    float cv = f_convertPrice(lvlStrike)
                    bool inRange = not showOnlyNear or (math.abs(close - cv) / close * 100.0 <= nearPct)
                    bool isGex = lvlType == "CW" or lvlType == "PW"
                    bool isSys = lvlType == "ZG" or lvlType == "MP" or lvlType == "EH" or lvlType == "EL" or lvlType == "VH" or lvlType == "VL"
                    bool isStr = lvlType == "PDH" or lvlType == "PDL" or lvlType == "PWH" or lvlType == "PWL"
                    bool isCM = lvlType == "CM"
                    bool isDF = lvlType == "DF"
                    bool passThresh = not enableThreshold or not isGex or nz(lvlMag) >= gexThreshold or nz(lvlMag) == 0.0
                    bool isAbove = cv > close
                    bool isProtected = (not na(closestAbove) and cv == closestAbove) or (not na(closestBelow) and cv == closestBelow)

                    bool shouldShow = false
                    if isGex and showGexLevels and passThresh
                        shouldShow := isProtected or (isAbove ? gexAboveDrawn < halfMax : gexBelowDrawn < halfMax)
                    else if isSys and showSystemLevels
                        shouldShow := true
                    else if isCM and showCharmMagnet
                        shouldShow := true
                    else if isDF and showDeltaFlip
                        shouldShow := true
                    // isStr (PDH/PDL/PWH/PWL) intentionally NOT drawn from the data
                    // string — PA is now computed autonomously from the chart's own
                    // OHLC below, so it is always in chart scale (no conversion, no
                    // cross-family contamination). The PA in the payload is ignored.

                    if shouldShow and inRange
                        color lvlColor = color.gray
                        int sc = 0
                        string finalTT = lvlTooltip
                        bool isWallFlipped = false

                        if lvlType == "CW"
                            // Nature color is preserved regardless of flip state — a CW
                            // remains a CW (pink/colorNeg) whether acting as resistance
                            // or as flipped potential support. The flip is communicated
                            // via reduced width + "↺" label suffix + tooltip phrasing.
                            isWallFlipped := f_getWallFlipped(lvlStrike)
                            lvlColor := colorNeg
                            if not isProtected
                                if isAbove
                                    gexAboveDrawn += 1
                                else
                                    gexBelowDrawn += 1
                            finalTT += "\n" + (isWallFlipped ? "Flipped Res → Sup (2× 5m close beyond)" : "Resistance")
                        else if lvlType == "PW"
                            isWallFlipped := f_getWallFlipped(lvlStrike)
                            lvlColor := colorPos
                            if not isProtected
                                if isAbove
                                    gexAboveDrawn += 1
                                else
                                    gexBelowDrawn += 1
                            finalTT += "\n" + (isWallFlipped ? "Flipped Sup → Res (2× 5m close beyond)" : "Support")
                        else if lvlType == "ZG"
                            lvlColor := colorZeroGamma
                        else if lvlType == "MP"
                            lvlColor := colorMaxPain
                            sc := 2
                        else if lvlType == "EH" or lvlType == "EL"
                            lvlColor := colorEM
                            sc := 1
                        else if lvlType == "VH" or lvlType == "VL"
                            lvlColor := colorVolBand
                            sc := 2
                        else if isStr
                            lvlColor := colorStructure
                            sc := 2
                        else if lvlType == "CM"
                            lvlColor := colorCharm
                        else if lvlType == "DF"
                            lvlColor := colorDeltaFlip
                            sc := 1

                        var string ls = line.style_dotted
                        ls := sc == 2 ? line.style_dotted : sc == 1 ? line.style_dashed : f_lineStyle(lineStyleInput)
                        if isCM
                            ls := line.style_solid
                        // Width: flipped CW/PW lose 1pt (min 1) so the line reads as
                        // "weakened in its current role". The user's chosen lineWidth
                        // remains the baseline for non-flipped walls.
                        int useWidth = isWallFlipped ? math.max(lineWidth - 1, 1) : lineWidth
                        array.push(gexLines, line.new(bar_index - lineLeftExt, cv, bar_index + profileOffset, cv, color=lvlColor, style=ls, width=useWidth, extend=extend.both))
                        string flipSuffix = isWallFlipped ? " ↺" : ""
                        string dLabel = f_formatPrice(lvlStrike) + " " + lvlType + " " + lvlLabel + flipSuffix
                        // Label anchor: "Left" keeps the historical placement (= clear of
                        // candles thanks to lineLeftExt). "Right" places the label past the
                        // GEX profile bars so it overlaps neither candles nor profile.
                        int lblX = labelSide == "Right" ? bar_index + profileOffset + profileWidth + 5 : bar_index - lineLeftExt
                        array.push(gexLabels, label.new(lblX, cv, dLabel, color=lvlColor, style=label.style_label_left, textcolor=color.white, size=size.small, tooltip=finalTT))

    // ── Draw Price Action (PDH/PDL/PWH/PWL) ──
    // Computed on the chart's OWN OHLC (dPrevH/dPrevL = prior day, wPrevH/wPrevL =
    // prior week, from the top-level request.security). Always in chart scale — no
    // f_convertPrice, no cross-family contamination. Replaces the PA that used to
    // arrive (and leak across tickers) in the data string.
    if showStructureLevels
        float[]  paPrices = array.from(dPrevH, dPrevL, wPrevH, wPrevL)
        string[] paCodes  = array.from("PDH", "PDL", "PWH", "PWL")
        string[] paNames  = array.from("Prior Day High", "Prior Day Low", "Prior Week High", "Prior Week Low")
        for pi = 0 to 3
            float paPrice = array.get(paPrices, pi)
            if not na(paPrice)
                array.push(gexLines, line.new(bar_index - lineLeftExt, paPrice, bar_index + profileOffset, paPrice, color=colorStructure, style=line.style_dotted, width=lineWidth, extend=extend.both))
                int paLblX = labelSide == "Right" ? bar_index + profileOffset + profileWidth + 5 : bar_index - lineLeftExt
                array.push(gexLabels, label.new(paLblX, paPrice, str.tostring(paPrice, format.mintick) + " " + array.get(paCodes, pi) + " " + array.get(paNames, pi), color=colorStructure, style=label.style_label_left, textcolor=color.white, size=size.small))

    // ── Draw Profile Bars ──
    if showProfile and profileData != ""
        string[] forzaPairs = str.split(str.replace_all(profileData, "\n", ""), ";")
        float maxAbsForza = 10.0
        float boxH = barThickness * syminfo.mintick
        int xZero = bar_index + profileOffset

        for pair in forzaPairs
            string[] parts = str.split(pair, ",")
            if array.size(parts) == 3
                float esStrike = str.tonumber(array.get(parts, 0))
                float forza = str.tonumber(array.get(parts, 1))
                float sign = str.tonumber(array.get(parts, 2))
                if not na(esStrike) and not na(forza)
                    float cvStrike = f_convertPrice(esStrike)
                    int barLen = int((forza / maxAbsForza) * profileWidth)
                    float intensity = math.abs(forza) / maxAbsForza
                    int fillT = int(80 - intensity * 50)
                    color barCall = barColorStyle == "Greyscale" ? #a0a0a0 : colorNeg
                    color barPut = barColorStyle == "Greyscale" ? #505050 : colorPos
                    color baseC = sign >= 0 ? barCall : barPut
                    array.push(gexBoxes, box.new(xZero, cvStrike + boxH / 2, xZero + barLen, cvStrike - boxH / 2, border_color=color.new(baseC, 0), border_width=1, bgcolor=color.new(baseC, fillT)))

    // ═════════════════════════════════════════════════════════════════
    // CONFLUENCE ZONES — cluster levels within ±5% prev-day ATR5 band
    // ═════════════════════════════════════════════════════════════════
    for b in confluenceBoxes
        box.delete(b)
    array.clear(confluenceBoxes)
    for lbl in confluenceLabels
        label.delete(lbl)
    array.clear(confluenceLabels)

    if showConfluence
        float band = confluenceBandPoints / 2.0  // half-band (e.g. 5 points → ±2.5)

        // Collect ALL levels into parallel arrays (price + name for tooltip)
        float[] allLevels = array.new_float()
        string[] allNames = array.new_string()

        // GEX walls + system + structure from parsed data
        if levelsData != ""
            string[] lpairs = str.split(levelsData, ";")
            for lpair in lpairs
                string[] p = str.split(lpair, ",")
                if array.size(p) >= 2
                    float s = str.tonumber(array.get(p, 0))
                    string t = array.get(p, 1)
                    if not na(s)
                        // PDH/PDL/PWH/PWL excluded here — PA now comes from the
                        // chart's own OHLC (added below), not the data string.
                        bool isTracked = t == "CW" or t == "PW" or t == "ZG" or t == "MP" or t == "EH" or t == "EL" or t == "VH" or t == "VL"
                        if isTracked
                            array.push(allLevels, f_convertPrice(s))
                            string nm = array.size(p) >= 3 ? array.get(p, 2) : t
                            array.push(allNames, str.tostring(math.round(s)) + " " + nm)

        // BOS levels (already converted)
        if array.size(bosLevels) > 0
            for i = 0 to array.size(bosLevels) - 1
                array.push(allLevels, array.get(bosLevels, i))
                string tf = array.size(bosTF) > i ? array.get(bosTF, i) : ""
                array.push(allNames, str.tostring(math.round(array.get(bosLevels, i))) + " BOS " + tf)

        // AVWAP values (each counts as a separate level)
        if not na(pAsia)
            array.push(allLevels, pAsia)
            array.push(allNames, str.tostring(math.round(pAsia)) + " AVWAP Asia")
        if not na(pEU)
            array.push(allLevels, pEU)
            array.push(allNames, str.tostring(math.round(pEU)) + " AVWAP EU")
        if not na(pUS)
            array.push(allLevels, pUS)
            array.push(allNames, str.tostring(math.round(pUS)) + " AVWAP US")
        if not na(pPD)
            array.push(allLevels, pPD)
            array.push(allNames, str.tostring(math.round(pPD)) + " AVWAP US PD")

        // Price Action from the chart's own OHLC (same source as the PA lines).
        if showStructureLevels
            if not na(dPrevH)
                array.push(allLevels, dPrevH)
                array.push(allNames, str.tostring(math.round(dPrevH)) + " PDH")
            if not na(dPrevL)
                array.push(allLevels, dPrevL)
                array.push(allNames, str.tostring(math.round(dPrevL)) + " PDL")
            if not na(wPrevH)
                array.push(allLevels, wPrevH)
                array.push(allNames, str.tostring(math.round(wPrevH)) + " PWH")
            if not na(wPrevL)
                array.push(allLevels, wPrevL)
                array.push(allNames, str.tostring(math.round(wPrevL)) + " PWL")

        // Parallel sort by price ascending (bubble sort to keep names in sync)
        int sz = array.size(allLevels)
        for i = 0 to sz - 2
            for j = 0 to sz - i - 2
                if array.get(allLevels, j) > array.get(allLevels, j + 1)
                    float tmpF = array.get(allLevels, j)
                    array.set(allLevels, j, array.get(allLevels, j + 1))
                    array.set(allLevels, j + 1, tmpF)
                    string tmpS = array.get(allNames, j)
                    array.set(allNames, j, array.get(allNames, j + 1))
                    array.set(allNames, j + 1, tmpS)

        // Walk and cluster: consecutive levels within band form a cluster
        int n = array.size(allLevels)
        if n >= 2
            int i = 0
            while i < n
                float clusterMin = array.get(allLevels, i)
                float clusterMax = clusterMin
                int size = 1
                string[] clusterItems = array.new_string()
                array.push(clusterItems, array.get(allNames, i))
                int j = i + 1
                while j < n
                    float next = array.get(allLevels, j)
                    if next - clusterMin <= 2 * band
                        clusterMax := next
                        size += 1
                        array.push(clusterItems, array.get(allNames, j))
                        j += 1
                    else
                        break
                if size >= confluenceMinSize
                    int scoreCapped = math.min(size, 5)
                    color boxColor = scoreCapped >= 5 ? colorConfluence5 : scoreCapped >= 4 ? colorConfluence4 : colorConfluence3
                    array.push(confluenceBoxes, box.new(bar_index - lineLeftExt, clusterMax, bar_index + profileOffset, clusterMin, border_color=color.new(boxColor, 50), border_width=1, bgcolor=boxColor))
                    string txt = scoreCapped >= 5 ? "UBER" : str.tostring(scoreCapped) + "x"
                    string tt = "Confluence " + str.tostring(size) + " levels:\n" + array.join(clusterItems, "\n")
                    array.push(confluenceLabels, label.new(bar_index + profileOffset, (clusterMax + clusterMin) / 2, txt, color=color.new(boxColor, 20), textcolor=color.white, style=label.style_label_left, size=size.small, tooltip=tt))
                i := j

    prevState := stateKey

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ALERTS                                                                      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

if enableAlerts and array.size(bosLevels) > 0
    for i = 0 to array.size(bosLevels) - 1
        float price = array.get(bosLevels, i)
        string tf = array.get(bosTF, i)
        bool touched = high >= price and low <= price
        bool crossUp = touched and close >= price and (open < price or low < price)
        bool crossDown = touched and close <= price and (open > price or high > price)
        if crossUp or crossDown
            string dir = crossUp ? "UP" : "DOWN"
            alert("TLADe BOS " + tf + " " + dir + " " + str.tostring(price, format.mintick), alert.freq_once_per_bar)
