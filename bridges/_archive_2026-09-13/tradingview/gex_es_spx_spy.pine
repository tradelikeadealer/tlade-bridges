groupTicker = "Ticker Settings"
tickerChoice = input.string("ES", "Display Ticker", options=["ES", "SPX", "SPY"], group=groupTicker)
// Spread is read from the WEEKLY_DATA / live override string (S:NN.NN|L:...). No
// hardcoded default — if the string is missing the S: prefix the convert
// function falls back to identity (= ES strikes shown unchanged).
var float esSpxSpread = 0.0

groupGex = "GEX Data"
string WEEKLY_DATA = input.text_area("S:15.58|L:7529,ZG,ZERO GAMMA,Zero Gamma~Key pivot where dealer gamma flips~Price magnet,0;7496,MP,MAX PAIN,Max Pain~Strike with maximum option pain~Expiry target,0;7464,EH,EM HIGH,Expected Move HIGH~1-sigma upper boundary~Statistical resistance,0;7335,EL,EM LOW,Expected Move LOW~1-sigma lower boundary~Statistical support,0;7561,VH,VOL HIGH,Vol Band HIGH~Volatility-based resistance~ZG + 25% EM,0;7496,VL,VOL LOW,Vol Band LOW~Volatility-based support~ZG - 25% EM,0;7466,PW,Put Wall,Strike: 7466~From Spot: +0.26%~Tot GEX: -540.91M~C/P Ratio: 0.5~Hold: 71% | Break: 29%,540.9;7516,CW,Call Wall,Strike: 7516~From Spot: +0.93%~Tot GEX: 52.45M~C/P Ratio: 1.1~Hold: 77% | Break: 23%,52.4;7556,CW,Call Wall,Strike: 7556~From Spot: +1.46%~Tot GEX: 713.88M~C/P Ratio: 12.4~Hold: 69% | Break: 31%,713.9;7541,CW,Call Wall,Strike: 7541~From Spot: +1.26%~Tot GEX: 326.28M~C/P Ratio: 2.5~Hold: 70% | Break: 30%,326.3;7476,CW,Call Wall,Strike: 7476~From Spot: +0.39%~Tot GEX: 337.52M~C/P Ratio: 3.1~Hold: 64% | Break: 36%,337.5;7566,CW,Call Wall,Strike: 7566~From Spot: +1.60%~Tot GEX: 231.51M~C/P Ratio: 2.2~Hold: 68% | Break: 32%,231.5;7486,PW,Put Wall,Strike: 7486~From Spot: +0.52%~Tot GEX: -296.67M~C/P Ratio: 0.4~Hold: 76% | Break: 24%,296.7;7511,PW,Put Wall,Strike: 7511~From Spot: +0.86%~Tot GEX: -220.45M~C/P Ratio: 0.4~Hold: 79% | Break: 21%,220.5;7616,CW,Call Wall,Strike: 7616~From Spot: +2.27%~Tot GEX: 299.04M~C/P Ratio: 4.1~Hold: 62% | Break: 38%,299.0;7501,CW,Call Wall,Strike: 7501~From Spot: +0.73%~Tot GEX: 75.07M~C/P Ratio: 1.4~Hold: 76% | Break: 24%,75.1;7506,CW,Call Wall,Strike: 7506~From Spot: +0.79%~Tot GEX: 114.21M~C/P Ratio: 1.7~Hold: 60% | Break: 40%,114.2;7491,CW,Call Wall,Strike: 7491~From Spot: +0.59%~Tot GEX: 23.22M~C/P Ratio: 1.1~Hold: 77% | Break: 23%,23.2;7456,PW,Put Wall,Strike: 7456~From Spot: +0.12%~Tot GEX: -80.07M~C/P Ratio: 0.7~Hold: 75% | Break: 25%,80.1;7646,CW,Call Wall,Strike: 7646~From Spot: +2.67%~Tot GEX: 364.89M~C/P Rat