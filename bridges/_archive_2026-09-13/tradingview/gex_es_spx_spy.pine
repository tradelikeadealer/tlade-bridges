//@version=6
indicator("GEX Levels + Breakout Structure + Session AVWAP — ES/SPX/SPY", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  INPUTS                                                                      ║
