// © TLADe Quantum Field Ladder v6.12.0
// Generated by tradelikeadealer.com
// Visualizes GEX levels as quantum fields with gradient intensity
// v6.8:    FREEZE ON LOAD - Levels locked until user updates data or changes settings
// v6.12.0: Zero Gamma is drawn ALWAYS (outside the Max Levels budget), in white and
//          labelled ZERO GAMMA instead of magenta WALL. ETF divisor read from
//          "R:<ratio>|" instead of the hardcoded 10 (SPY) and 40 (QQQ).
// v6.8.1:  Guards on PHASE 2/3/4 loops — prevents RE10045 array OOB when one side has 0 levels
// v6.9.0:  Display Ticker (ES/SPX/SPY) — scales levels for SPX (-spread) and SPY ((-spread)/10).
//          Optional "S:<spread>|" prefix on the data string is auto-parsed; manual override
//          in settings as fallback for older payloads.
// v6.10.0: User-customisable line width / line style / label size. Top-N counter raised
//          to 60 so users can show more of the chain on busy days.
// v6.11.0: Added NQ / NDX / QQQ to Display Ticker. Single indicator now handles both the
//          ES and NQ futures families. NQ = identity (same as ES). NDX = futures − spread
//          (the S: prefix carries NQ-NDX basis for NQ data, ES-SPX for ES data — both work).
//          QQQ = (futures − spread) / 40, the conventional NDX-to-QQQ ratio.
//@version=6
indicator("Quantum Field Ladder", overlay=true, max_lines_count=500, max_labels_count=50)

// ============== SETTINGS ==============
string groupData = "Data"
string groupField = "Field Settings"
string groupStyle = "Line & Label Style"
string groupCol = "Colors"

// Quantum data: [S:<spread>|]strike,intensity,type,rangeUp,rangeDown,wallType,tooltip;...
string quantumDataInput = input.text_area("", title="Quantum Data", group=groupData, tooltip="Copy from Terminal to update. Format: strike,intensity,type,rangeUp,rangeDown,wallType,tooltip. Optional leading 'S:<spread>|' carries the ES↔SPX offset. CHANGING DATA RECENTERS ON CURRENT PRICE.")
string tickerChoice = input.string("ES", "Display Ticker", options=["ES", "SPX", "SPY", "NQ", "NDX", "QQQ"], group=groupData, tooltip="Pick your chart's ticker so levels render in the right scale. ES / NQ = identity (futures, no conversion). SPX / NDX = futures − spread (cash index). SPY = (futures − spread) / 10. QQQ = (futures − spread) / 40. The S: prefix in the data string carries the active futures-cash basis (ES-SPX for ES family, NQ-NDX for NQ family).")
float spreadOverride = input.float(0.0, "Futures-Cash Spread Override", group=groupData, tooltip="Only used when the data string has no leading 'S:<spread>|' prefix. Leave 0 to auto-parse. Carries ES-SPX or NQ-NDX basis depending on the data source.")

int gradientSteps = input.int(10, "Gradient Smoothness", minval=6, maxval=16, group=groupField, tooltip="More steps = smoother gradient, but uses more drawing objects")
float fieldScale = input.float(0.5, "Field Scale", minval=0.2, maxval=1.5, step=0.1, group=groupField, tooltip="Multiply field width by this factor")
bool showCenterLine = input.bool(true, "Show Center Line", group=groupField)
int labelOffset = input.int(0, "Label Offset (bars)", minval=-50, maxval=50, step=5, group=groupField, tooltip="Move labels left (-) or right (+) from center. 0 = centered on last bar")
int maxLevels = input.int(20, "Max Levels to Show", minval=5, maxval=60, group=groupField, tooltip="Top-N levels by intensity to render around current price (split N/2 above + N/2 below). Lower = cleaner chart, higher = more chain context. CHANGING THIS RECENTERS LEVELS ON CURRENT PRICE.")

// Line & label customisation — Fred (2026-05-14): "make the lines more
// user definable regarding line width and line style, same for text sizes"
int gradientLineWidth = input.int(1, "Gradient Line Width", minval=1, maxval=4, group=groupStyle, tooltip="Width of the lines used to build the field gradient. Higher = denser look.")
int centerLineWidth = input.int(2, "Center Line Width", minval=1, maxval=5, group=groupStyle, tooltip="Width of the solid line through the strike centre.")
string centerLineStyleChoice = input.string("solid", "Center Line Style", options=["solid", "dashed", "dotted"], group=groupStyle, tooltip="Style of the centre line.")
string labelSizeChoice = input.string("normal", "Label Size", options=["tiny", "small", "normal", "large", "huge"], group=groupStyle, tooltip="Size of the strike + MAGNET/WALL labels.")

color colorMagnet = input.color(#22d3ee, "Magnet (Attractor)", group=groupCol, tooltip="Cyan - price is attracted to these levels")
color colorWall = input.color(#f472b6, "Wall (Repulsor)", group=groupCol, tooltip="Magenta - price is repelled from these levels")
// Zero Gamma is white everywhere in TLADe, and settable so a light-background chart
// can turn it grey. It used to arrive with nodeType 0 and be painted as a magenta
// wall, which made the most important level in the method indistinguishable from an
// ordinary one. (v6.12.0)
color colorZeroGamma = input.color(#ffffff, "Zero Gamma", group=groupCol, tooltip="White - the pivot where dealer gamma flips sign. Not a wall and not a magnet.")
int alphaOuter = input.int(95, "Outer Transparency", minval=80, maxval=98, group=groupCol)
int alphaInner = input.int(40, "Inner Transparency", minval=10, maxval=70, group=groupCol)

// Pine v6 — `line.new(style=…)` requires a `const int`-compatible value and
// won't accept a series-int from a runtime ternary. We can't resolve the
// chosen style into a single variable; we have to branch and call line.new
// with the literal `line.style_*` constant in each branch. Same trick for
// `label.new(size=…)`. The helpers below take the user's string choice and
// emit a line/label with the right constant directly.
f_makeCenterLine(int x1, float y, color col, int w, string sty) =>
    line cl = na
    if sty == "dashed"
        cl := line.new(x1, y, x1 + 1, y, color=col, width=w, style=line.style_dashed, extend=extend.both)
    else if sty == "dotted"
        cl := line.new(x1, y, x1 + 1, y, color=col, width=w, style=line.style_dotted, extend=extend.both)
    else
        cl := line.new(x1, y, x1 + 1, y, color=col, width=w, style=line.style_solid, extend=extend.both)
    cl

f_makeStrikeLabel(int x, float y, string txt, color bg, string sz, string tip) =>
    label lb = na
    if sz == "tiny"
        lb := label.new(x, y, txt, color=bg, style=label.style_label_center, textcolor=color.white, size=size.tiny, tooltip=tip)
    else if sz == "small"
        lb := label.new(x, y, txt, color=bg, style=label.style_label_center, textcolor=color.white, size=size.small, tooltip=tip)
    else if sz == "large"
        lb := label.new(x, y, txt, color=bg, style=label.style_label_center, textcolor=color.white, size=size.large, tooltip=tip)
    else if sz == "huge"
        lb := label.new(x, y, txt, color=bg, style=label.style_label_center, textcolor=color.white, size=size.huge, tooltip=tip)
    else
        lb := label.new(x, y, txt, color=bg, style=label.style_label_center, textcolor=color.white, size=size.normal, tooltip=tip)
    lb

// Spread is parsed from the data string (or set via override) inside the
// recalc block below. f_convertPrice is the central price-scaling helper:
// identity for futures (ES / NQ), subtract spread for cash indices
// (SPX / NDX), divide for ETFs (SPY ÷10, QQQ ÷40).
// The single `esSpxSpread` var holds whichever futures-cash basis the
// active data source carries (ES-SPX for ES family, NQ-NDX for NQ family).
// v6.12.0: the ETF divisor is READ from the data string ("R:<ratio>|"), not written
// here. The hardcoded 10.0 and 40.0 were the conventional ratios, and the real ones
// move every day: on 14 October 2026 SPX/SPY was 10.033 and NDX/QQQ 41.1, so every
// SPY level came out ~7.5 points high and every QQQ level ~26 points high — a silent
// offset on exactly the charts where a level either holds or it doesn't. The GEX
// Dashboard Pine has read R: since 12 October; the Ladder was never taught to.
// Without R: the old constants are used, so an older payload still renders.
var float esSpxSpread = 0.0
var float etfRatio = 0.0
f_etfDivisor(float fallback) =>
    etfRatio > 0.0 ? etfRatio : fallback
f_convertPrice(float esPrice) =>
    (tickerChoice == "SPX" or tickerChoice == "NDX") ? esPrice - esSpxSpread : tickerChoice == "SPY" ? (esPrice - esSpxSpread) / f_etfDivisor(10.0) : tickerChoice == "QQQ" ? (esPrice - esSpxSpread) / f_etfDivisor(40.0) : esPrice


// ============== STATE ==============
var line[] allLines = array.new_line()
var line[] centerLines = array.new_line()
var linefill[] allFills = array.new_linefill()
var label[] allLabels = array.new_label()
var int lastDrawnBar = -1

// ═══════════════════════════════════════════════════════════════════════════════
// v6.8: FROZEN LEVELS STATE
// Levels are calculated ONCE when data changes, then stay frozen
// ═══════════════════════════════════════════════════════════════════════════════
var string[] frozenNodes = array.new_string()    // Frozen quantum nodes
var string lastFrozenData = ""                    // Track data changes
var int lastFrozenMaxLevels = 0                   // Track max levels changes

// Check if we need to recalculate
bool needsRecalc = quantumDataInput != lastFrozenData or maxLevels != lastFrozenMaxLevels

// ============== CLEAR FUNCTION ==============
f_clearAll() =>
    if array.size(allFills) > 0
        for i = 0 to array.size(allFills) - 1
            linefill.delete(array.get(allFills, i))
        array.clear(allFills)

    if array.size(allLines) > 0
        for i = 0 to array.size(allLines) - 1
            line.delete(array.get(allLines, i))
        array.clear(allLines)

    if array.size(centerLines) > 0
        for i = 0 to array.size(centerLines) - 1
            line.delete(array.get(centerLines, i))
        array.clear(centerLines)

    if array.size(allLabels) > 0
        for i = 0 to array.size(allLabels) - 1
            label.delete(array.get(allLabels, i))
        array.clear(allLabels)

// ═══════════════════════════════════════════════════════════════════════════════
// v6.8: FREEZE LEVELS ON LOAD/UPDATE
// Calculate which levels to show ONCE, then keep them frozen
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast and needsRecalc and quantumDataInput != ""
    // Clear frozen array
    array.clear(frozenNodes)

    // Strip an optional "S:<spread>|<rest>" prefix from the data string.
    // If present, the parsed value becomes the active esSpxSpread used by
    // f_convertPrice for SPX/SPY scaling. Otherwise we fall back to the
    // manual Spread Override input, so older payloads keep working.
    string payload = quantumDataInput
    esSpxSpread := spreadOverride
    string[] hdrParts = str.split(quantumDataInput, "|")
    if array.size(hdrParts) > 1
        string firstChunk = array.get(hdrParts, 0)
        if str.startswith(firstChunk, "S:")
            float parsed = str.tonumber(str.substring(firstChunk, 2, str.length(firstChunk)))
            if not na(parsed)
                esSpxSpread := parsed
            array.shift(hdrParts)
            payload := array.join(hdrParts, "|")
    // "R:<ratio>|" may follow S:. Parsed in its own pass so a payload that carries
    // R: without S:, or S: without R:, both work. Order of the two is the order the
    // terminal writes them: S: then R:. (v6.12.0)
    etfRatio := 0.0
    string[] ratioParts = str.split(payload, "|")
    if array.size(ratioParts) > 1
        string rChunk = array.get(ratioParts, 0)
        if str.startswith(rChunk, "R:")
            float parsedR = str.tonumber(str.substring(rChunk, 2, str.length(rChunk)))
            if not na(parsedR) and parsedR > 0.0
                etfRatio := parsedR
            array.shift(ratioParts)
            payload := array.join(ratioParts, "|")

    string[] nodes = str.split(payload, ";")

    // Temporary arrays for sorting - ABOVE price
    float[] aboveStrikes = array.new_float()
    float[] aboveIntensities = array.new_float()
    string[] aboveData = array.new_string()

    // Temporary arrays for sorting - BELOW price
    float[] belowStrikes = array.new_float()
    float[] belowIntensities = array.new_float()
    string[] belowData = array.new_string()

    // System levels (today: Zero Gamma) live OUTSIDE the top-N budget.
    //
    // Zero Gamma arrives with intensity 0, PHASE 2/3 sort by intensity descending,
    // and PHASE 4 takes the first halfMax of each side — so with the default
    // maxLevels of 20 it was dropped whenever its side of price held 10 or more
    // nodes, which on a normal chain is most of the time. The generator's comment
    // said "always visible"; it was always last in the queue. It is not a node
    // competing for space with the walls, it is the pivot the whole method is read
    // against, so it is kept aside here and appended unconditionally. (v6.12.0)
    string[] systemNodes = array.new_string()

    // Reference price for splitting (FROZEN at this moment)
    float refPrice = close

    // PHASE 1: Parse and split above/below current price
    for node in nodes
        string[] parts = str.split(node, ",")
        if array.size(parts) >= 6
            float strike = str.tonumber(array.get(parts, 0))
            float intensity = str.tonumber(array.get(parts, 1))

            if not na(strike) and not na(intensity) and array.get(parts, 5) == "ZG"
                array.push(systemNodes, node)
            else if not na(strike) and not na(intensity)
                float convertedStrike = f_convertPrice(strike)

                if convertedStrike > refPrice
                    array.push(aboveStrikes, convertedStrike)
                    array.push(aboveIntensities, intensity)
                    array.push(aboveData, node)
                else
                    array.push(belowStrikes, convertedStrike)
                    array.push(belowIntensities, intensity)
                    array.push(belowData, node)

    // PHASE 2: Sort ABOVE levels by intensity (highest first)
    // GUARD: Pine `for 0 to -1` still executes once → empty array would crash array.get()
    int sizeAbove = array.size(aboveIntensities)
    if sizeAbove > 1
        for i = 0 to sizeAbove - 2
            for j = 0 to sizeAbove - i - 2
                if array.get(aboveIntensities, j) < array.get(aboveIntensities, j + 1)
                    float tmpI = array.get(aboveIntensities, j)
                    array.set(aboveIntensities, j, array.get(aboveIntensities, j + 1))
                    array.set(aboveIntensities, j + 1, tmpI)
                    float tmpS = array.get(aboveStrikes, j)
                    array.set(aboveStrikes, j, array.get(aboveStrikes, j + 1))
                    array.set(aboveStrikes, j + 1, tmpS)
                    string tmpD = array.get(aboveData, j)
                    array.set(aboveData, j, array.get(aboveData, j + 1))
                    array.set(aboveData, j + 1, tmpD)

    // PHASE 3: Sort BELOW levels by intensity (highest first)
    // GUARD: same Pine quirk as PHASE 2
    int sizeBelow = array.size(belowIntensities)
    if sizeBelow > 1
        for i = 0 to sizeBelow - 2
            for j = 0 to sizeBelow - i - 2
                if array.get(belowIntensities, j) < array.get(belowIntensities, j + 1)
                    float tmpI = array.get(belowIntensities, j)
                    array.set(belowIntensities, j, array.get(belowIntensities, j + 1))
                    array.set(belowIntensities, j + 1, tmpI)
                    float tmpS = array.get(belowStrikes, j)
                    array.set(belowStrikes, j, array.get(belowStrikes, j + 1))
                    array.set(belowStrikes, j + 1, tmpS)
                    string tmpD = array.get(belowData, j)
                    array.set(belowData, j, array.get(belowData, j + 1))
                    array.set(belowData, j + 1, tmpD)

    // PHASE 4: Take top N/2 from each side and FREEZE them
    // GUARD: same Pine quirk — `for 0 to -1` would crash on empty array
    int halfMax = math.ceil(maxLevels / 2)

    int takeAbove = math.min(halfMax, array.size(aboveData))
    if takeAbove > 0
        for i = 0 to takeAbove - 1
            array.push(frozenNodes, array.get(aboveData, i))

    int takeBelow = math.min(halfMax, array.size(belowData))
    if takeBelow > 0
        for i = 0 to takeBelow - 1
            array.push(frozenNodes, array.get(belowData, i))

    // System levels are not subject to maxLevels.
    if array.size(systemNodes) > 0
        for i = 0 to array.size(systemNodes) - 1
            array.push(frozenNodes, array.get(systemNodes, i))

    // Update frozen state trackers
    lastFrozenData := quantumDataInput
    lastFrozenMaxLevels := maxLevels

// ═══════════════════════════════════════════════════════════════════════════════
// DRAW FROM FROZEN LEVELS (every bar, but levels don't change)
// ═══════════════════════════════════════════════════════════════════════════════
bool newBar = bar_index != lastDrawnBar
bool visualSettingsChanged = gradientSteps != gradientSteps[1] or fieldScale != fieldScale[1] or showCenterLine != showCenterLine[1] or colorMagnet != colorMagnet[1] or colorWall != colorWall[1] or colorZeroGamma != colorZeroGamma[1] or alphaOuter != alphaOuter[1] or alphaInner != alphaInner[1] or gradientLineWidth != gradientLineWidth[1] or centerLineWidth != centerLineWidth[1] or centerLineStyleChoice != centerLineStyleChoice[1] or labelSizeChoice != labelSizeChoice[1]

if barstate.islast and (newBar or needsRecalc or visualSettingsChanged)
    lastDrawnBar := bar_index

    f_clearAll()

    // Draw all FROZEN nodes (guard: Pine for 0 to -1 still executes once)
    if array.size(frozenNodes) > 0
        for idx = 0 to array.size(frozenNodes) - 1
            string node = array.get(frozenNodes, idx)
            string[] parts = str.split(node, ",")

            if array.size(parts) >= 6
                float strike = str.tonumber(array.get(parts, 0))
                float intensity = str.tonumber(array.get(parts, 1))
                float nodeType = str.tonumber(array.get(parts, 2))
                float rangeUp = str.tonumber(array.get(parts, 3))
                float rangeDown = str.tonumber(array.get(parts, 4))
                string wallType = array.get(parts, 5)
                string tooltip = array.size(parts) >= 7 ? str.replace_all(array.get(parts, 6), "~", "\n") : ""

                if not na(strike) and not na(rangeUp) and not na(rangeDown)
                    float convertedStrike = f_convertPrice(strike)
                    float convertedUp = f_convertPrice(rangeUp)
                    float convertedDown = f_convertPrice(rangeDown)

                    // Apply field scale
                    float fieldHalfWidth = (convertedUp - convertedDown) / 2 * fieldScale
                    float scaledUp = convertedStrike + fieldHalfWidth
                    float scaledDown = convertedStrike - fieldHalfWidth

                    // Determine color: Zero Gamma first, then type (1 = Magnet, 0 = Wall).
                    // wallType was parsed and then never used for rendering, so ZG took
                    // its colour from nodeType 0 and came out as a magenta wall labelled
                    // WALL. Its rangeUp and rangeDown both equal the strike, so it draws
                    // as a bare line with no field around it — which is what it is.
                    bool isZeroGamma = wallType == "ZG"
                    bool isMagnet = nodeType == 1
                    color baseCol = isZeroGamma ? colorZeroGamma : isMagnet ? colorMagnet : colorWall

                    // Adjust transparency based on intensity (1-5)
                    int intensityBoost = int((intensity - 1) * 5)
                    int adjustedInner = math.max(10, alphaInner - intensityBoost)

                    // Create gradient lines from center outward
                    line[] nodeLines = array.new_line()

                    // Upper half gradient (center to top)
                    for i = 0 to gradientSteps
                        float ratio = i / gradientSteps
                        float y = convertedStrike + (scaledUp - convertedStrike) * ratio
                        int alpha = int(adjustedInner + (alphaOuter - adjustedInner) * ratio)
                        line l = line.new(bar_index, y, bar_index + 1, y, color=color.new(baseCol, alpha), width=gradientLineWidth, extend=extend.both)
                        array.push(nodeLines, l)
                        array.push(allLines, l)

                    // Lower half gradient (center to bottom)
                    for i = 0 to gradientSteps
                        float ratio = i / gradientSteps
                        float y = convertedStrike - (convertedStrike - scaledDown) * ratio
                        int alpha = int(adjustedInner + (alphaOuter - adjustedInner) * ratio)
                        line l = line.new(bar_index, y, bar_index + 1, y, color=color.new(baseCol, alpha), width=gradientLineWidth, extend=extend.both)
                        array.push(nodeLines, l)
                        array.push(allLines, l)

                    // Create linefills between adjacent lines (upper half)
                    for i = 0 to gradientSteps - 1
                        int alpha = int(adjustedInner + (alphaOuter - adjustedInner) * (i / gradientSteps))
                        linefill f = linefill.new(array.get(nodeLines, i), array.get(nodeLines, i + 1), color.new(baseCol, alpha))
                        array.push(allFills, f)

                    // Create linefills (lower half)
                    for i = 0 to gradientSteps - 1
                        int alpha = int(adjustedInner + (alphaOuter - adjustedInner) * (i / gradientSteps))
                        int upperIdx = gradientSteps + 1 + i
                        int lowerIdx = gradientSteps + 1 + i + 1
                        if lowerIdx < array.size(nodeLines)
                            linefill f = linefill.new(array.get(nodeLines, upperIdx), array.get(nodeLines, lowerIdx), color.new(baseCol, alpha))
                            array.push(allFills, f)

                    // Center label: Strike - Type
                    string nodeLabel = isZeroGamma ? "ZERO GAMMA" : isMagnet ? "MAGNET" : "WALL"
                    string txt = str.tostring(convertedStrike, "#") + " " + nodeLabel
                    color labelBg = color.new(baseCol, adjustedInner + 10)
                    label lb = f_makeStrikeLabel(bar_index + labelOffset, convertedStrike, txt, labelBg, labelSizeChoice, tooltip)
                    array.push(allLabels, lb)

                    // Center line (solid, same color as field)
                    if showCenterLine
                        line cl = f_makeCenterLine(bar_index, convertedStrike, color.new(baseCol, 20), centerLineWidth, centerLineStyleChoice)
                        array.push(centerLines, cl)
